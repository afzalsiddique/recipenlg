#!/bin/bash
#PBS -N recipenlg-prepare-text
#PBS -q preemptible
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=04:00:00
#PBS -W group_list=x-ccast-prj-chayan
#PBS -m abe
#PBS -M m.afzalsiddique@ndus.edu

cd "$PBS_O_WORKDIR"
source pbs/env.sh

python -m generation.prepare_text \
    --input_csv /mmfs1/projects/changhui.yan/m.afzalsiddique/datasets/RecipeNLG/full_dataset.csv \
    --output_dir generation/data \
    --train_filename unsupervised_train.txt \
    --test_filename unsupervised_test.txt \
    --gold_filename gold_test_100.json \
    --test_size 0.05 \
    --n_gold 100 \
    --min_title_len 4 \
    --min_directions_count 2 \
    --min_directions_chars 30 \
    --min_ingredients_chars 2 \
    --seed 42
